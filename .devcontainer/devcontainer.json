{
  "name": "SAM - AI Content Writing Agent",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "bash setup.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SAM Web UI (OpenCode)",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["editorconfig.editorconfig"]
    }
  },
  "remoteEnv": {
    "SAM_MODEL": "opencode/deepseek-v4.1-flash-free"
  }
}

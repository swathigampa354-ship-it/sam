{
  "name": "SAM - AI Content Writing Agent",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "postCreateCommand": "bash setup.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SAM Local Dev Web UI",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["editorconfig.editorconfig"]
    }
  }
}

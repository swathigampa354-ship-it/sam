# SAM / OpenCode configuration — copy to ".env" and adjust.
# Everything here is OPTIONAL for the zero-cost default (OpenCode free models).

# ─────────────────────────────────────────────────────────────
# Model used by SAM. Default = OpenCode free model (NO API key / NO cost).
SAM_MODEL=opencode/deepseek-v4.1-flash-free
# Other free options:
#   opencode/nemotron-3.5-lightning-free
#   opencode/beam-free
#   opencode/hy4-flash-free

# Web UI port (Codespaces forwards this as PRIVATE by default).
SAM_PORT=3000

# Password for the OpenCode web UI (auto-generated if left empty). Keep secret.
OPENCODE_SERVER_PASSWORD=

# ── Optional providers (only if you want better/paid models) ──

# OpenAI GPT-5.4 — the original SAM default. Requires a PAID OpenAI key.
OPENAI_API_KEY=

# Exa web-search MCP (optional). Without it, SAM writes from its own knowledge.
EXA_API_KEY=

# GitHub Models (free via your GitHub Copilot entitlement). In Codespaces the
# GITHUB_TOKEN is injected automatically. To use it, configure a custom
# openai-compatible provider pointing at https://models.inference.ai.azure.com
# with api_key = $GITHUB_TOKEN, then set SAM_MODEL to e.g. github/gpt-4o-mini.
GITHUB_TOKEN=
